# CryptoAudit website configuration. Copy to .env (never commit .env) and fill in.
# Settings are read from CRYPTOAUDIT_* environment variables or this file (run `cryptoaudit serve` from the repo root).

# --- GitHub App (see docs/development/website.md for the step-by-step setup) ---
CRYPTOAUDIT_GITHUB_CLIENT_ID=
CRYPTOAUDIT_GITHUB_CLIENT_SECRET=
# The app's URL slug: https://github.com/apps/<slug>
CRYPTOAUDIT_GITHUB_APP_SLUG=

# --- Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRYPTOAUDIT_SESSION_SECRET=
# Browser-facing origin. The GitHub App callback URL must be <public_url>/api/auth/github/callback
CRYPTOAUDIT_PUBLIC_URL=http://localhost:5173
# Set to true when the site is served over HTTPS
CRYPTOAUDIT_COOKIE_SECURE=false

# --- Local LLM for S3/S4 and AI explanations (optional; skipped when unavailable) ---
CRYPTOAUDIT_LLM_BASE_URL=http://localhost:11434
CRYPTOAUDIT_LLM_MODEL=codellama:7b-instruct

# --- Baseline scanners used for S1 hints and V0 (Semgrep needs network access and is slower) ---
CRYPTOAUDIT_ENABLE_BANDIT=true
CRYPTOAUDIT_ENABLE_SEMGREP=false

# --- Limits ---
CRYPTOAUDIT_MAX_REPO_MB=50
CRYPTOAUDIT_MAX_PYTHON_FILES=500
CRYPTOAUDIT_SCAN_WORKERS=2

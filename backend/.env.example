# CryptoAudit website configuration. Copy to .env (never commit .env) and fill in.
# Settings are read from CRYPTOAUDIT_* environment variables or this file (run `cryptoaudit serve` from backend/).

# --- GitHub OAuth App (see docs/development/website.md for the step-by-step setup) ---
CRYPTOAUDIT_GITHUB_CLIENT_ID=
CRYPTOAUDIT_GITHUB_CLIENT_SECRET=
# private: scan private repos too (requests the `repo` scope; CryptoAudit only reads)
# public:  public repositories only (no repository scope)
CRYPTOAUDIT_GITHUB_REPO_ACCESS=private

# --- Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRYPTOAUDIT_SESSION_SECRET=
# Browser-facing origin. The OAuth App callback URL must be <public_url>/api/auth/github/callback
CRYPTOAUDIT_PUBLIC_URL=http://localhost:5173
# Set to true when the site is served over HTTPS
CRYPTOAUDIT_COOKIE_SECURE=false

# --- Local LLM for S3/S4 and AI explanations (optional; skipped when unavailable) ---
CRYPTOAUDIT_LLM_BASE_URL=http://localhost:11434
CRYPTOAUDIT_LLM_MODEL=qwen2.5-coder:7b
# Context window for prompt + complete answer. Files that do not fit are skipped (never truncated).
# 8192 suits a 4 GB GPU; raise it for larger files if you have more GPU memory.
CRYPTOAUDIT_LLM_NUM_CTX=8192
# One generation may take minutes on small GPUs
CRYPTOAUDIT_LLM_TIMEOUT=600

# --- Baseline scanners used for S1 hints and V0 (Semgrep needs network access and is slower) ---
CRYPTOAUDIT_ENABLE_BANDIT=true
CRYPTOAUDIT_ENABLE_SEMGREP=false

# --- Limits (raise them for very large projects) ---
# Compressed archive of the scanned commit; git history is NOT downloaded, so this is usually far
# smaller than the size GitHub shows for the repository.
CRYPTOAUDIT_MAX_REPO_MB=500
# Everything inside the archive, including non-Python files (protects against decompression bombs)
CRYPTOAUDIT_MAX_UNPACKED_MB=4096
CRYPTOAUDIT_MAX_PYTHON_FILES=5000
# Larger .py files (usually generated code) are skipped and listed in the results
CRYPTOAUDIT_MAX_FILE_KB=1024
# Files repaired/validated in parallel within one scan
CRYPTOAUDIT_SCAN_PARALLELISM=4
# Scans running at the same time (across users)
CRYPTOAUDIT_SCAN_WORKERS=2
